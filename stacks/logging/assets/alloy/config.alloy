// Grafana Alloy — single source, single sink.
//
// Source: systemd journal at /var/log/journal (bind-mounted ro).
// Sink:   Loki at http://loki:3100 (monitoring-net DNS).
//
// Relabel rules keep the label set deliberately small to avoid
// cardinality blow-up:
//   - unit       → systemd unit (e.g. podman-jellyfin.service)
//   - container  → podman container name (set by --log-driver=journald)
//   - host       → hostname
//   - level      → priority keyword (info|warning|err|...)
//
// Everything else stays in the log line (queryable via LogQL line
// filters), not as labels.

logging {
  level  = "warn"
  format = "logfmt"
}

loki.write "default" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}

loki.relabel "journal" {
  forward_to = []

  rule {
    source_labels = ["__journal__systemd_unit"]
    target_label  = "unit"
  }
  rule {
    source_labels = ["__journal__hostname"]
    target_label  = "host"
  }
  rule {
    source_labels = ["__journal_container_name"]
    target_label  = "container"
  }
  rule {
    source_labels = ["__journal_priority_keyword"]
    target_label  = "level"
  }

  // ===== stack label =====
  // Derive a stack label from the container name (or systemd unit
  // for native NixOS services) so the Drilldown UI and LogQL queries
  // can group logs by stack instead of by container. Cardinality
  // stays the same because stack is fully determined by container —
  // not an independent dimension.

  rule {
    source_labels = ["__journal_container_name"]
    regex         = "^(immich|immich-.+)$"
    target_label  = "stack"
    replacement   = "immich"
  }
  rule {
    source_labels = ["__journal_container_name"]
    regex         = "^nextcloud-(app|exporter|postgres|redis)$"
    target_label  = "stack"
    replacement   = "nextcloud"
  }
  rule {
    source_labels = ["__journal_container_name"]
    regex         = "^(gluetun|gluetun-exporter|qbittorrent|nzbget|prowlarr|radarr|sonarr|bazarr|flaresolverr|jellyfin)$"
    target_label  = "stack"
    replacement   = "tv"
  }
  rule {
    source_labels = ["__journal_container_name"]
    regex         = "^(prometheus|grafana|cadvisor|node-exporter)$"
    target_label  = "stack"
    replacement   = "monitoring"
  }
  rule {
    source_labels = ["__journal_container_name"]
    regex         = "^(loki|alloy)$"
    target_label  = "stack"
    replacement   = "logging"
  }
  rule {
    source_labels = ["__journal_container_name"]
    regex         = "^litellm(-db)?$"
    target_label  = "stack"
    replacement   = "litellm"
  }
  rule {
    source_labels = ["__journal_container_name"]
    regex         = "^n8n(-postgres)?$"
    target_label  = "stack"
    replacement   = "n8n"
  }
  rule {
    source_labels = ["__journal_container_name"]
    regex         = "^(traefik|cloudflared|wireguard|wg-easy)$"
    target_label  = "stack"
    replacement   = "infra"
  }
  rule {
    source_labels = ["__journal_container_name"]
    regex         = "^(grocy|metube|stirling-pdf|wealthfolio|factorio)$"
    target_label  = "stack"
    replacement   = "apps"
  }

  // ===== myStack.apps platform =====
  // app-<name> (the app container) and pg-<name> (its postgres) share
  // a service_name = <name> so Grafana Drilldown groups them under one
  // "service" entry. Apps platform containers also land in stack=apps
  // (alongside the LAN tools above; differentiate via service_name).
  rule {
    source_labels = ["__journal_container_name"]
    regex         = "^(app|pg)-(.+)$"
    target_label  = "stack"
    replacement   = "apps"
  }
  rule {
    source_labels = ["__journal_container_name"]
    regex         = "^(app|pg)-(.+)$"
    target_label  = "service_name"
    replacement   = "$2"
  }
  rule {
    source_labels = ["__journal_container_name"]
    regex         = "^(app|pg)-(.+)$"
    target_label  = "component"
    replacement   = "$1"
  }

  // Pi-hole runs as a native NixOS service (no container) — match on unit.
  rule {
    source_labels = ["__journal__systemd_unit"]
    regex         = "^pihole-(ftl|web)\\.service$"
    target_label  = "stack"
    replacement   = "infra"
  }
}

loki.source.journal "system" {
  path          = "/var/log/journal"
  max_age       = "12h"
  forward_to    = [loki.write.default.receiver]
  relabel_rules = loki.relabel.journal.rules
  labels        = {
    job = "systemd-journal",
  }
}
