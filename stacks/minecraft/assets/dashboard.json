    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-default"
      },
      "description": "Server-list ping answered. This is the game speaking, not the container being up — a wedged JVM still shows a running container.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [
            {
              "options": {
                "0": {
                  "color": "red",
                  "index": 1,
                  "text": "not answering"
                },
                "1": {
                  "color": "green",
                  "index": 0,
                  "text": "answering"
                }
              },
              "type": "value"
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": 0
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "unit": "none"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 0,
        "y": 0
