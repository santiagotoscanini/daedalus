{
  "uid": "s2-plane",
  "title": "Plane",
  "tags": ["services", "plane"],
  "schemaVersion": 41,
  "editable": false,
  "refresh": "5m",
  "time": { "from": "now-30d", "to": "now" },
  "timepicker": {},
  "templating": { "list": [] },
  "annotations": { "list": [] },
  "panels": [
    {
      "id": 1500,
      "type": "row",
      "title": "Instance",
      "collapsed": false,
      "gridPos": { "x": 0, "y": 0, "w": 24, "h": 1 },
      "panels": []
    },
    {
      "id": 1501,
      "type": "stat",
      "title": "Telemetry pipeline",
      "description": "Plane pushes gauges to the local OTel collector every METRICS_PUSH_INTERVAL_MINUTES; this is the prometheus scrape of that collector. DOWN means no metrics, not necessarily a down app — gatus probes the app itself.",
      "gridPos": { "x": 0, "y": 1, "w": 4, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus-default" },
      "targets": [{ "refId": "A", "expr": "up{job=\"plane\"}", "instant": true }],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": { "text": "DOWN", "color": "red" },
                "1": { "text": "UP", "color": "green" }
              }
            }
          ],
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto"
      }
    },
    {
      "id": 1502,
      "type": "stat",
      "title": "Version",
      "description": "current_version from the instances row. `latest_version` is refreshed from the GitHub releases API on every api start; when they differ, an upgrade is available.",
      "gridPos": { "x": 4, "y": 1, "w": 5, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus-default" },
      "targets": [
        {
          "refId": "A",
          "expr": "plane_instance_users_total",
          "instant": true,
          "legendFormat": "{{current_version}} / {{latest_version}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": { "mode": "fixed", "fixedColor": "text" }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "auto",
        "textMode": "name",
        "colorMode": "none",
        "graphMode": "none",
        "justifyMode": "auto"
      }
    },
    {
      "id": 1503,
      "type": "stat",
      "title": "Users",
      "gridPos": { "x": 9, "y": 1, "w": 3, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus-default" },
      "targets": [{ "refId": "A", "expr": "plane_instance_users_total", "instant": true }],
      "fieldConfig": {
        "defaults": { "unit": "short", "color": { "mode": "fixed", "fixedColor": "blue" } },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto"
      }
    },
    {
      "id": 1504,
      "type": "stat",
      "title": "Workspaces",
      "gridPos": { "x": 12, "y": 1, "w": 3, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus-default" },
      "targets": [{ "refId": "A", "expr": "plane_instance_workspaces_total", "instant": true }],
      "fieldConfig": {
        "defaults": { "unit": "short", "color": { "mode": "fixed", "fixedColor": "purple" } },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto"
      }
    },
    {
      "id": 1505,
      "type": "stat",
      "title": "Projects",
      "gridPos": { "x": 15, "y": 1, "w": 3, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus-default" },
      "targets": [{ "refId": "A", "expr": "plane_instance_projects_total", "instant": true }],
      "fieldConfig": {
        "defaults": { "unit": "short", "color": { "mode": "fixed", "fixedColor": "green" } },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto"
      }
    },
    {
      "id": 1506,
      "type": "stat",
      "title": "Work items",
      "gridPos": { "x": 18, "y": 1, "w": 3, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus-default" },
      "targets": [{ "refId": "A", "expr": "plane_instance_issues_total", "instant": true }],
      "fieldConfig": {
        "defaults": { "unit": "short", "color": { "mode": "fixed", "fixedColor": "orange" } },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto"
      }
    },
    {
      "id": 1507,
      "type": "stat",
      "title": "Pages",
      "gridPos": { "x": 21, "y": 1, "w": 3, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus-default" },
      "targets": [{ "refId": "A", "expr": "plane_instance_pages_total", "instant": true }],
      "fieldConfig": {
        "defaults": { "unit": "short", "color": { "mode": "fixed", "fixedColor": "yellow" } },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto"
      }
    },
    {
      "id": 1510,
      "type": "row",
      "title": "Growth",
      "collapsed": false,
      "gridPos": { "x": 0, "y": 5, "w": 24, "h": 1 },
      "panels": []
    },
    {
      "id": 1511,
      "type": "timeseries",
      "title": "Instance totals over time",
      "description": "Gauges refresh only when Plane's beat task fires, so the lines are step functions at the push interval — not a sampling artefact.",
      "gridPos": { "x": 0, "y": 6, "w": 16, "h": 9 },
      "datasource": { "type": "prometheus", "uid": "prometheus-default" },
      "targets": [
        { "refId": "A", "expr": "plane_instance_issues_total", "legendFormat": "work items" },
        { "refId": "B", "expr": "plane_instance_projects_total", "legendFormat": "projects" },
        { "refId": "C", "expr": "plane_instance_cycles_total", "legendFormat": "cycles" },
        { "refId": "D", "expr": "plane_instance_modules_total", "legendFormat": "modules" },
        { "refId": "E", "expr": "plane_instance_pages_total", "legendFormat": "pages" },
        { "refId": "F", "expr": "plane_instance_users_total", "legendFormat": "users" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "stepAfter",
            "lineWidth": 2,
            "fillOpacity": 5,
            "showPoints": "never",
            "spanNulls": true
          },
          "color": { "mode": "palette-classic" }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "right", "calcs": ["lastNotNull", "max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    },
    {
      "id": 1512,
      "type": "timeseries",
      "title": "Work items added per day",
      "description": "increase() over the issue-count gauge. Deletions show as a flat line, not a dip, because increase() ignores decreases.",
      "gridPos": { "x": 16, "y": 6, "w": 8, "h": 9 },
      "datasource": { "type": "prometheus", "uid": "prometheus-default" },
      "targets": [
        {
          "refId": "A",
          "expr": "increase(plane_instance_issues_total[1d])",
          "legendFormat": "work items /d"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 1,
            "fillOpacity": 60,
            "showPoints": "never"
          },
          "color": { "mode": "fixed", "fixedColor": "orange" }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "hidden", "placement": "bottom" },
        "tooltip": { "mode": "single", "sort": "none" }
      }
    },
    {
      "id": 1520,
      "type": "row",
      "title": "Per workspace",
      "collapsed": false,
      "gridPos": { "x": 0, "y": 15, "w": 24, "h": 1 },
      "panels": []
    },
    {
      "id": 1521,
      "type": "table",
      "title": "Workspace breakdown",
      "description": "One row per workspace, from the plane_workspace_* gauge family (capped at 1000 workspaces upstream).",
      "gridPos": { "x": 0, "y": 16, "w": 24, "h": 10 },
      "datasource": { "type": "prometheus", "uid": "prometheus-default" },
      "targets": [
        {
          "refId": "A",
          "expr": "plane_workspace_projects_total",
          "instant": true,
          "format": "table"
        },
        {
          "refId": "B",
          "expr": "plane_workspace_issues_total",
          "instant": true,
          "format": "table"
        },
        {
          "refId": "C",
          "expr": "plane_workspace_cycles_total",
          "instant": true,
          "format": "table"
        },
        {
          "refId": "D",
          "expr": "plane_workspace_modules_total",
          "instant": true,
          "format": "table"
        },
        {
          "refId": "E",
          "expr": "plane_workspace_pages_total",
          "instant": true,
          "format": "table"
        },
        {
          "refId": "F",
          "expr": "plane_workspace_members_total",
          "instant": true,
          "format": "table"
        }
      ],
      "transformations": [
        { "id": "merge", "options": {} },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "job": true,
              "instance": true,
              "instance_id": true,
              "workspace_id": true,
              "plane_instance_type": true,
              "service_name": true,
              "otel_scope_name": true,
              "otel_scope_version": true,
              "otel_scope_schema_url": true,
              "telemetry_sdk_language": true,
              "telemetry_sdk_name": true,
              "telemetry_sdk_version": true
            },
            "renameByName": {
              "workspace_slug": "Workspace",
              "Value #A": "Projects",
              "Value #B": "Work items",
              "Value #C": "Cycles",
              "Value #D": "Modules",
              "Value #E": "Pages",
              "Value #F": "Members"
            },
            "indexByName": {}
          }
        },
        { "id": "sortBy", "options": { "sort": [{ "field": "Work items", "desc": true }] } }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "align": "auto", "cellOptions": { "type": "auto" } }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Work items" },
            "properties": [
              { "id": "custom.cellOptions", "value": { "type": "gauge", "mode": "gradient" } }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "footer": { "show": true, "reducer": ["sum"], "fields": "" }
      }
    },
    {
      "id": 1530,
      "type": "row",
      "title": "Containers",
      "collapsed": false,
      "gridPos": { "x": 0, "y": 26, "w": 24, "h": 1 },
      "panels": []
    },
    {
      "id": 1531,
      "type": "timeseries",
      "title": "Container liveness",
      "description": "container_up comes from the host-liveness-exporter textfile metric — rootless podman cgroups are invisible to cgroup exporters, so this is the per-container signal available.",
      "gridPos": { "x": 0, "y": 27, "w": 24, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus-default" },
      "targets": [
        {
          "refId": "A",
          "expr": "container_up{name=~\"plane-.*\"}",
          "legendFormat": "{{name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "max": 1,
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "stepAfter",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never"
          },
          "color": { "mode": "palette-classic" }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "right", "calcs": ["lastNotNull"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    }
  ]
}
