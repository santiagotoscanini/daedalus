  "schemaVersion": 41,
  "version": 1,
  "panels": [
    {
      "id": 400,
      "type": "row",
      "title": "Pool Health",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 401,
      "type": "stat",
      "title": "ZFS Pool State (worst)",
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 8,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-default"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(node_zfs_zpool_state)",
          "legendFormat": "",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-default"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "ONLINE",
                  "color": "green",
                  "index": 0
                },
                "1": {
                  "text": "DEGRADED",
                  "color": "orange",
                  "index": 1
                },
                "2": {
                  "text": "FAULTED",
                  "color": "red",
                  "index": 2
                },
                "3": {
                  "text": "OFFLINE",
                  "color": "red",
                  "index": 3
                },
                "4": {
                  "text": "REMOVED",
                  "color": "red",
                  "index": 4
                },
                "5": {
                  "text": "UNAVAIL",
                  "color": "red",
                  "index": 5
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "auto"
      }
    },
    {
      "id": 402,
      "type": "gauge",
      "title": "s2-pool %",
      "gridPos": {
        "x": 8,
        "y": 1,
        "w": 8,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-default"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * sum(node_filesystem_size_bytes{device=~\"s2-pool.*\"} - node_filesystem_avail_bytes{device=~\"s2-pool.*\"}) / (sum(node_filesystem_size_bytes{device=~\"s2-pool.*\"} - node_filesystem_avail_bytes{device=~\"s2-pool.*\"}) + sum(node_filesystem_avail_bytes{mountpoint=\"/s2\"}))",
          "legendFormat": "",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-default"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 80
              },
              {
                "color": "red",
                "value": 95
              }
            ]
          },
          "decimals": 1,
          "min": 0,
          "max": 100
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "showThresholdLabels": false,
        "showThresholdMarkers": true
      }
    },
