        "x": 0,
        "y": 38,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "loki",
        "uid": "loki-default"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(count_over_time({container=\"pocket-id\"} |= `status=` | regexp `status=(?P<status>[0-9]+)` | status =~ `4..` [$__range]))",
          "queryType": "instant",
          "datasource": {
            "type": "loki",
            "uid": "loki-default"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 100
              },
              {
                "color": "red",
                "value": 1000
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
