{
  "uid": "s2-security",
  "title": "Security",
  "description": "Who reaches this box from the internet, and what they do. The router forwards only 51820/udp (WireGuard) and 34197/udp (Factorio) — 22, 80, 443, 53 and postgres are LAN-only, so public HTTP arrives exclusively through the Cloudflare tunnel (cfweb entrypoint). That tunnel is what this dashboard watches. Note the view is post-Cloudflare: requests the CF edge blocks never reach us.",
  "tags": [
    "system",
    "security"
  ],
  "timezone": "browser",
  "refresh": "30s",
  "schemaVersion": 41,
  "version": 1,
  "panels": [
    {
      "id": 700,
      "type": "row",
      "title": "Public edge — Cloudflare tunnel (the only way in from the internet)",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 701,
      "type": "stat",
      "title": "Remote requests (range)",
      "description": "Every request that arrived through the Cloudflare tunnel in the selected range.",
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "loki",
        "uid": "loki-default"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(count_over_time({container=\"traefik\"} |= `cfweb` | json | entryPointName = `cfweb` [$__range]))",
          "queryType": "instant",
          "datasource": {
            "type": "loki",
            "uid": "loki-default"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto"
      }
    },
    {
