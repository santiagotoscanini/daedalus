      "targets": [
        {
          "refId": "A",
          "expr": "sum by (code) (rate(traefik_entrypoint_requests_total{entrypoint=\"cfweb\"}[$__rate_interval]))",
          "legendFormat": "{{code}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-default"
          }
        }
      ],
      "fieldConfig": {
