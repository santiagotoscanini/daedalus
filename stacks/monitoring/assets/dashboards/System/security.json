      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(count_over_time({container=\"pocket-id\"} |= `status=` | regexp `status=(?P<status>[0-9]+)` | status =~ `[23]..` [$__auto]))",
          "legendFormat": "ok (2xx/3xx)",
          "queryType": "range",
          "datasource": {
            "type": "loki",
            "uid": "loki-default"
