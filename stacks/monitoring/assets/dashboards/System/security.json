      "targets": [
        {
          "refId": "A",
          "expr": "sum(count_over_time({container=\"traefik\"} |= `cfweb` | json | entryPointName = `cfweb` | DownstreamStatus =~ `[45]..` [$__range]))",
          "queryType": "instant",
