    {
      "id": 721,
      "type": "stat",
      "title": "Auth rejections (range)",
      "description": "4xx answered by the identity provider itself — rejected logins, invalid or expired authorization flows. This is the closest thing to a brute-force signal in this topology, since SSH is not reachable from the internet.",
