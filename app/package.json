{
  "name": "daedalus",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=24",
    "pnpm": ">=11"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "node scripts/build.mjs",
    "start": "node server.mjs",
    "preview": "vite preview",
    "generate-routes": "tsr generate",
