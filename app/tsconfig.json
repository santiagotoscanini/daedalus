{
  "include": ["**/*.ts", "**/*.tsx"],
  "exclude": ["node_modules", ".output", ".tanstack", "dist"],
  "compilerOptions": {
    "target": "ES2022",
    "jsx": "react-jsx",
    "module": "ESNext",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    /* "node" alongside vite/client: the server routes read process.env and the
       postgres client is a Node module. */
    "types": ["vite/client", "node"],

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,

    /* Linting */
    "skipLibCheck": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    /* The render switches. A `switch (data.tab)` whose return type is inferred
       widens to `ReactNode | undefined` the moment a tab has no case, and the
       page renders nothing with no error anywhere. This turns that into
       TS7030 at the function that stopped being exhaustive. */
    "noImplicitReturns": true,
    "noUncheckedSideEffectImports": true
  }
}
