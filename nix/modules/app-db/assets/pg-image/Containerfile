# pgvector-enabled build of the shared cluster's postgres image.
#
# FROM a digest-pinned alpine base handed in as BASE (`pgBase` in
# ../../app-db.nix, the one place it is written), so the
# in-container postgres UID stays 70 — no data-dir re-chown, no
# 70-vs-105 trap on the live cluster.
#
# pgvector is compiled from source, pinned by tag. `with_llvm=no`
# overrides the PGXS default so the build never needs clang/llvm to
# emit JIT bitcode (the base image's llvm config then doesn't matter);
# postgres simply skips JIT for vector ops — a negligible cost here.
ARG BASE
FROM ${BASE}
RUN set -eux; \
    apk add --no-cache --virtual .build-deps build-base git; \
    git clone --branch v0.8.5 --depth 1 https://github.com/pgvector/pgvector.git /tmp/pgvector; \
    cd /tmp/pgvector; \
    make OPTFLAGS="" with_llvm=no; \
    make OPTFLAGS="" with_llvm=no install; \
    cd /; \
    rm -rf /tmp/pgvector; \
    apk del .build-deps
