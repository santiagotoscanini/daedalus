      "datasource": { "type": "prometheus", "uid": "dfakbms70z4zke" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(nextcloud_storage_bytes{storage!~\"local::/var/www/html/data/\"})",
          "legendFormat": "",
