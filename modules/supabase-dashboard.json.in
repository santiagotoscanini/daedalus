{
  "uid": "supabase-%PROJECT_ID%",
  "title": "Home Server — Supabase: %PROJECT_ID%",
  "tags": ["s2-server", "supabase"],
  "timezone": "browser",
  "refresh": "30s",
  "schemaVersion": 41,
  "version": 1,
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 100,
      "type": "row",
      "title": "Overview",
      "gridPos": { "x": 0, "y": 0, "w": 24, "h": 1 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 101,
      "type": "stat",
      "title": "DB Up",
      "gridPos": { "x": 0, "y": 1, "w": 4, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "dfakbms70z4zke" },
      "targets": [{ "refId": "A", "expr": "pg_up{job=\"%DB_JOB%\"}" }],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [
            { "type": "value", "options": { "0": { "text": "DOWN", "color": "red" } } },
            { "type": "value", "options": { "1": { "text": "UP",   "color": "green" } } }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }]
          }
        }
      },
      "options": { "colorMode": "background", "graphMode": "none", "textMode": "value" }
    },
    {
      "id": 102,
      "type": "stat",
      "title": "Active Connections",
      "gridPos": { "x": 4, "y": 1, "w": 4, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "dfakbms70z4zke" },
      "targets": [{
        "refId": "A",
        "expr": "sum(pg_stat_database_numbackends{job=\"%DB_JOB%\", datname!=\"\"})"
      }],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 50 },
              { "color": "red", "value": 80 }
            ]
          }
        }
      },
      "options": { "colorMode": "value", "graphMode": "area" }
    },
    {
      "id": 103,
      "type": "stat",
      "title": "postgres DB size",
      "gridPos": { "x": 8, "y": 1, "w": 4, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "dfakbms70z4zke" },
      "targets": [{
        "refId": "A",
        "expr": "pg_database_size_bytes{job=\"%DB_JOB%\", datname=\"postgres\"}"
      }],
      "fieldConfig": {
        "defaults": {
          "unit": "decbytes",
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "blue", "value": null }] }
        }
      },
      "options": { "colorMode": "value", "graphMode": "area" }
    },
    {
      "id": 104,
      "type": "stat",
      "title": "_supabase DB size",
      "gridPos": { "x": 12, "y": 1, "w": 4, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "dfakbms70z4zke" },
      "targets": [{
        "refId": "A",
        "expr": "pg_database_size_bytes{job=\"%DB_JOB%\", datname=\"_supabase\"}"
      }],
      "fieldConfig": {
        "defaults": {
          "unit": "decbytes",
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "purple", "value": null }] }
        }
      },
      "options": { "colorMode": "value", "graphMode": "area" }
    },
    {
      "id": 105,
      "type": "stat",
      "title": "Cache hit ratio",
      "gridPos": { "x": 16, "y": 1, "w": 4, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "dfakbms70z4zke" },
      "targets": [{
        "refId": "A",
        "expr": "sum(rate(pg_stat_database_blks_hit{job=\"%DB_JOB%\"}[5m])) / (sum(rate(pg_stat_database_blks_hit{job=\"%DB_JOB%\"}[5m])) + sum(rate(pg_stat_database_blks_read{job=\"%DB_JOB%\"}[5m])))"
      }],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red",    "value": null },
              { "color": "yellow", "value": 0.9 },
              { "color": "green",  "value": 0.99 }
            ]
          }
        }
      },
      "options": { "colorMode": "background", "graphMode": "area" }
    },
    {
      "id": 106,
      "type": "stat",
      "title": "Deadlocks (5m rate)",
      "gridPos": { "x": 20, "y": 1, "w": 4, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "dfakbms70z4zke" },
      "targets": [{
        "refId": "A",
        "expr": "sum(rate(pg_stat_database_deadlocks{job=\"%DB_JOB%\"}[5m]))"
      }],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green",  "value": null },
              { "color": "yellow", "value": 0.001 },
              { "color": "red",    "value": 0.01 }
            ]
          }
        }
      },
      "options": { "colorMode": "value", "graphMode": "area" }
    },

    {
      "id": 200,
      "type": "row",
      "title": "Database Activity",
      "gridPos": { "x": 0, "y": 5, "w": 24, "h": 1 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 201,
      "type": "timeseries",
      "title": "Transactions / s",
      "gridPos": { "x": 0, "y": 6, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "dfakbms70z4zke" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (datname) (rate(pg_stat_database_xact_commit{job=\"%DB_JOB%\", datname!=\"\"}[5m]))",
          "legendFormat": "commit · {{datname}}"
        },
        {
          "refId": "B",
          "expr": "sum by (datname) (rate(pg_stat_database_xact_rollback{job=\"%DB_JOB%\", datname!=\"\"}[5m]))",
          "legendFormat": "rollback · {{datname}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 10, "showPoints": "never" }
        }
      }
    },
    {
      "id": 202,
      "type": "timeseries",
      "title": "Row activity / s (postgres DB)",
      "gridPos": { "x": 12, "y": 6, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "dfakbms70z4zke" },
      "targets": [
        { "refId": "A", "expr": "rate(pg_stat_database_tup_fetched{job=\"%DB_JOB%\", datname=\"postgres\"}[5m])",    "legendFormat": "fetched" },
        { "refId": "B", "expr": "rate(pg_stat_database_tup_returned{job=\"%DB_JOB%\", datname=\"postgres\"}[5m])",   "legendFormat": "returned" },
        { "refId": "C", "expr": "rate(pg_stat_database_tup_inserted{job=\"%DB_JOB%\", datname=\"postgres\"}[5m])",   "legendFormat": "inserted" },
        { "refId": "D", "expr": "rate(pg_stat_database_tup_updated{job=\"%DB_JOB%\", datname=\"postgres\"}[5m])",    "legendFormat": "updated" },
        { "refId": "E", "expr": "rate(pg_stat_database_tup_deleted{job=\"%DB_JOB%\", datname=\"postgres\"}[5m])",    "legendFormat": "deleted" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "rows/sec",
          "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 10, "showPoints": "never" }
        }
      }
    },

    {
      "id": 300,
      "type": "row",
      "title": "Connections, Locks & Sizes",
      "gridPos": { "x": 0, "y": 14, "w": 24, "h": 1 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 301,
      "type": "timeseries",
      "title": "Connections by database",
      "gridPos": { "x": 0, "y": 15, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "dfakbms70z4zke" },
      "targets": [{
        "refId": "A",
        "expr": "pg_stat_database_numbackends{job=\"%DB_JOB%\", datname!=\"\"}",
        "legendFormat": "{{datname}}"
      }],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 20, "stacking": { "mode": "normal" }, "showPoints": "never" }
        }
      }
    },
    {
      "id": 302,
      "type": "timeseries",
      "title": "Locks by mode",
      "gridPos": { "x": 12, "y": 15, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "dfakbms70z4zke" },
      "targets": [{
        "refId": "A",
        "expr": "sum by (mode) (pg_locks_count{job=\"%DB_JOB%\"})",
        "legendFormat": "{{mode}}"
      }],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 10, "showPoints": "never" }
        }
      }
    },
    {
      "id": 303,
      "type": "bargauge",
      "title": "Database sizes",
      "gridPos": { "x": 0, "y": 23, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "dfakbms70z4zke" },
      "targets": [{
        "refId": "A",
        "expr": "pg_database_size_bytes{job=\"%DB_JOB%\", datname!~\"template.*\"}",
        "legendFormat": "{{datname}}",
        "instant": true
      }],
      "fieldConfig": {
        "defaults": {
          "unit": "decbytes",
          "color": { "mode": "continuous-GrYlRd" }
        }
      },
      "options": { "displayMode": "gradient", "orientation": "horizontal", "showUnfilled": true }
    },
    {
      "id": 304,
      "type": "timeseries",
      "title": "WAL position progress",
      "gridPos": { "x": 12, "y": 23, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "dfakbms70z4zke" },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(pg_stat_database_xact_commit{job=\"%DB_JOB%\", datname=\"postgres\"}[5m]) + rate(pg_stat_database_xact_commit{job=\"%DB_JOB%\", datname=\"_supabase\"}[5m])",
          "legendFormat": "writes/s (commit, postgres+_supabase)"
        },
        {
          "refId": "B",
          "expr": "rate(pg_stat_database_blk_read_time{job=\"%DB_JOB%\", datname=\"postgres\"}[5m])",
          "legendFormat": "block read time (postgres)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 10, "showPoints": "never" }
        }
      }
    },

    {
      "id": 400,
      "type": "row",
      "title": "Background writer & checkpoints",
      "gridPos": { "x": 0, "y": 31, "w": 24, "h": 1 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 401,
      "type": "timeseries",
      "title": "Checkpoints (timed vs requested)",
      "gridPos": { "x": 0, "y": 32, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "dfakbms70z4zke" },
      "targets": [
        { "refId": "A", "expr": "rate(pg_stat_bgwriter_checkpoints_timed_total{job=\"%DB_JOB%\"}[5m])",     "legendFormat": "timed" },
        { "refId": "B", "expr": "rate(pg_stat_bgwriter_checkpoints_req_total{job=\"%DB_JOB%\"}[5m])",       "legendFormat": "requested" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 10, "showPoints": "never" }
        }
      }
    },
    {
      "id": 402,
      "type": "timeseries",
      "title": "Buffers written by source",
      "gridPos": { "x": 12, "y": 32, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "dfakbms70z4zke" },
      "targets": [
        { "refId": "A", "expr": "rate(pg_stat_bgwriter_buffers_checkpoint_total{job=\"%DB_JOB%\"}[5m])",    "legendFormat": "checkpoint" },
        { "refId": "B", "expr": "rate(pg_stat_bgwriter_buffers_clean_total{job=\"%DB_JOB%\"}[5m])",         "legendFormat": "bgwriter" },
        { "refId": "C", "expr": "rate(pg_stat_bgwriter_buffers_backend_total{job=\"%DB_JOB%\"}[5m])",       "legendFormat": "backend" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 10, "showPoints": "never" }
        }
      }
    },
    {
      "id": 403,
      "type": "text",
      "title": "Not yet wired",
      "gridPos": { "x": 0, "y": 40, "w": 24, "h": 4 },
      "options": {
        "mode": "markdown",
        "content": "**Per-supabase-container CPU/RAM/Network panels were omitted.** cAdvisor on this host only sees the root cgroup (`id=\"/\"`) — rootless podman containers under `user.slice/user@1000.service/...` are not visible to it. Fixing this is a pre-existing monitoring task (not Supabase-specific). For per-service metrics, the alternatives are:\n\n- Enable Kong's `prometheus` plugin and add `kong:8001/metrics` to prometheus scrape\n- Set `METRICS_JWT_SECRET` on supavisor (already set, but the scrape needs a JWT bearer)\n- Enable GoTrue metrics on `auth:9100` via `GOTRUE_METRICS_ENABLED=true`\n- Add vector's own `/metrics` endpoint (port 9001, already exposed inside the bridge)"
      }
    }
  ]
}
