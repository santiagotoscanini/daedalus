# Auto-generated by supabase-<id>-bootstrap on first boot.
#
# This file is NOT in git (containers/*/env is gitignored). To
# re-roll secrets, delete this file and rebuild — the bootstrap
# unit will regenerate it, which invalidates every existing JWT.
# Back up first!
#
# Layout:
#   1. Project identity + URLs (deterministic from <id>)
#   2. Primitive secrets (randomly generated)
#   3. Per-container env vars, mirroring upstream supabase's
#      docker-compose interpolation but baked at first-boot.

# ── 1. Project identity & URLs ─────────────────────────────────
GLOBAL_S3_BUCKET=@@PROJECT_ID@@
POOLER_TENANT_ID=@@PROJECT_ID@@
STORAGE_TENANT_ID=default
REGION=local
STUDIO_DEFAULT_ORGANIZATION=@@PROJECT_ID@@
STUDIO_DEFAULT_PROJECT=@@PROJECT_ID@@
API_EXTERNAL_URL=https://@@KONG_HOST@@
SUPABASE_PUBLIC_URL=https://@@KONG_HOST@@
SITE_URL=https://@@STUDIO_HOST@@
ADDITIONAL_REDIRECT_URLS=

# ── 2. Primitive secrets ───────────────────────────────────────
POSTGRES_PASSWORD=@@POSTGRES_PASSWORD@@
JWT_SECRET=@@JWT_SECRET@@
ANON_KEY=@@ANON_KEY@@
SERVICE_ROLE_KEY=@@SERVICE_ROLE_KEY@@
DASHBOARD_USERNAME=supabase
DASHBOARD_PASSWORD=@@DASHBOARD_PASSWORD@@
SECRET_KEY_BASE=@@SECRET_KEY_BASE@@
VAULT_ENC_KEY=@@VAULT_ENC_KEY@@
PG_META_CRYPTO_KEY=@@PG_META_CRYPTO_KEY@@
LOGFLARE_PUBLIC_ACCESS_TOKEN=@@LOGFLARE_PUBLIC_ACCESS_TOKEN@@
LOGFLARE_PRIVATE_ACCESS_TOKEN=@@LOGFLARE_PRIVATE_ACCESS_TOKEN@@
S3_PROTOCOL_ACCESS_KEY_ID=@@S3_PROTOCOL_ACCESS_KEY_ID@@
S3_PROTOCOL_ACCESS_KEY_SECRET=@@S3_PROTOCOL_ACCESS_KEY_SECRET@@

# Asymmetric (EC) keys — optional. Empty means containers fall
# back to the HS256 JWT_SECRET above. Generate with
# `supabase keys add-new` if/when you want to migrate.
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
JWT_KEYS=
JWT_JWKS=
ANON_KEY_ASYMMETRIC=
SERVICE_ROLE_KEY_ASYMMETRIC=

# ── 3. Postgres connection primitives ──────────────────────────
POSTGRES_DB=postgres
POSTGRES_HOST=db
POSTGRES_PORT=5432

# ── 4. Kong gateway ────────────────────────────────────────────
KONG_HTTP_PORT=8000
KONG_HTTPS_PORT=8443
SUPABASE_ANON_KEY=@@ANON_KEY@@
SUPABASE_SERVICE_KEY=@@SERVICE_ROLE_KEY@@

# ── 5. Pooler (Supavisor) ──────────────────────────────────────
POOLER_PROXY_PORT_TRANSACTION=6543
POOLER_DEFAULT_POOL_SIZE=20
POOLER_MAX_CLIENT_CONN=100
POOLER_POOL_MODE=transaction
POOLER_DB_POOL_SIZE=5
DATABASE_URL=ecto://supabase_admin:@@POSTGRES_PASSWORD@@@db:5432/_supabase
API_JWT_SECRET=@@JWT_SECRET@@
METRICS_JWT_SECRET=@@JWT_SECRET@@

# ── 6. Auth (GoTrue) ───────────────────────────────────────────
JWT_EXPIRY=3600
DISABLE_SIGNUP=false
GOTRUE_DB_DATABASE_URL=postgres://supabase_auth_admin:@@POSTGRES_PASSWORD@@@db:5432/postgres
GOTRUE_SITE_URL=https://@@STUDIO_HOST@@
GOTRUE_URI_ALLOW_LIST=
GOTRUE_DISABLE_SIGNUP=false
GOTRUE_JWT_EXP=3600
GOTRUE_JWT_SECRET=@@JWT_SECRET@@
GOTRUE_JWT_ISSUER=https://@@KONG_HOST@@/auth/v1
GOTRUE_EXTERNAL_EMAIL_ENABLED=true
GOTRUE_EXTERNAL_ANONYMOUS_USERS_ENABLED=false
GOTRUE_MAILER_AUTOCONFIRM=true
GOTRUE_EXTERNAL_PHONE_ENABLED=true
GOTRUE_SMS_AUTOCONFIRM=true
GOTRUE_SMTP_ADMIN_EMAIL=admin@example.com
GOTRUE_SMTP_HOST=supabase-mail
GOTRUE_SMTP_PORT=2500
GOTRUE_SMTP_USER=fake_mail_user
GOTRUE_SMTP_PASS=fake_mail_password
GOTRUE_SMTP_SENDER_NAME=fake_sender
GOTRUE_MAILER_URLPATHS_INVITE=/auth/v1/verify
GOTRUE_MAILER_URLPATHS_CONFIRMATION=/auth/v1/verify
GOTRUE_MAILER_URLPATHS_RECOVERY=/auth/v1/verify
GOTRUE_MAILER_URLPATHS_EMAIL_CHANGE=/auth/v1/verify

# Mailer URL paths (public — referenced indirectly)
MAILER_URLPATHS_CONFIRMATION=/auth/v1/verify
MAILER_URLPATHS_INVITE=/auth/v1/verify
MAILER_URLPATHS_RECOVERY=/auth/v1/verify
MAILER_URLPATHS_EMAIL_CHANGE=/auth/v1/verify
ENABLE_EMAIL_SIGNUP=true
ENABLE_EMAIL_AUTOCONFIRM=true
ENABLE_ANONYMOUS_USERS=false
ENABLE_PHONE_SIGNUP=true
ENABLE_PHONE_AUTOCONFIRM=true
SMTP_ADMIN_EMAIL=admin@example.com
SMTP_HOST=supabase-mail
SMTP_PORT=2500
SMTP_USER=fake_mail_user
SMTP_PASS=fake_mail_password
SMTP_SENDER_NAME=fake_sender

# ── 7. PostgREST ───────────────────────────────────────────────
PGRST_DB_URI=postgres://authenticator:@@POSTGRES_PASSWORD@@@db:5432/postgres
PGRST_DB_SCHEMAS=public,storage,graphql_public
PGRST_DB_MAX_ROWS=1000
PGRST_DB_EXTRA_SEARCH_PATH=public
PGRST_JWT_SECRET=@@JWT_SECRET@@
PGRST_APP_SETTINGS_JWT_SECRET=@@JWT_SECRET@@
PGRST_APP_SETTINGS_JWT_EXP=3600

# ── 8. Realtime ────────────────────────────────────────────────
DB_HOST=db
DB_PORT=5432
DB_USER=supabase_admin
DB_PASSWORD=@@POSTGRES_PASSWORD@@
DB_NAME=postgres

# ── 9. Storage ─────────────────────────────────────────────────
STORAGE_DATABASE_URL=postgres://supabase_storage_admin:@@POSTGRES_PASSWORD@@@db:5432/postgres
AUTH_JWT_SECRET=@@JWT_SECRET@@

# ── 10. imgproxy ───────────────────────────────────────────────
IMGPROXY_AUTO_WEBP=true

# ── 11. Functions (edge-runtime) ───────────────────────────────
SUPABASE_ANON_KEY_FN=@@ANON_KEY@@
SUPABASE_SERVICE_ROLE_KEY=@@SERVICE_ROLE_KEY@@
SUPABASE_DB_URL=postgresql://postgres:@@POSTGRES_PASSWORD@@@db:5432/postgres
SUPABASE_PUBLISHABLE_KEYS={"default":""}
SUPABASE_SECRET_KEYS={"default":""}
FUNCTIONS_VERIFY_JWT=false

# ── 12. Studio ─────────────────────────────────────────────────
STUDIO_PORT=3000

# ── 13. Logflare / analytics misc placeholders ─────────────────
GOOGLE_PROJECT_ID=GOOGLE_PROJECT_ID
GOOGLE_PROJECT_NUMBER=GOOGLE_PROJECT_NUMBER

# ── 14. MFA / SAML / OAuth (all disabled by default) ───────────
MFA_TOTP_ENROLL_ENABLED=true
MFA_TOTP_VERIFY_ENABLED=true
MFA_PHONE_ENROLL_ENABLED=false
MFA_PHONE_VERIFY_ENABLED=false
MFA_MAX_ENROLLED_FACTORS=10
GOOGLE_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_SECRET=
GITHUB_ENABLED=false
GITHUB_CLIENT_ID=
GITHUB_SECRET=
AZURE_ENABLED=false
AZURE_CLIENT_ID=
AZURE_SECRET=
SAML_ENABLED=false
SAML_PRIVATE_KEY=
SAML_ALLOW_ENCRYPTED_ASSERTIONS=false
SAML_RELAY_STATE_VALIDITY_PERIOD=2m0s
SAML_EXTERNAL_URL=
SAML_RATE_LIMIT_ASSERTION=15
SMS_PROVIDER=
SMS_OTP_EXP=60
SMS_OTP_LENGTH=6
SMS_MAX_FREQUENCY=60s
SMS_TEMPLATE=Your code is {{ .Code }}
SMS_TEST_OTP=
SMS_TWILIO_ACCOUNT_SID=
SMS_TWILIO_AUTH_TOKEN=
SMS_TWILIO_MESSAGE_SERVICE_SID=
