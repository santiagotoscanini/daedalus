# Everything secret is gitignored by directory. `secrets/` is the
# only place secrets live; assets/ + module .nix files are always
# tracked. Catch all depths.
**/secrets/
**/secrets

# Backup files we may create during refactors.
*.bak
*.bak.*

# Nix build artifacts (in case anyone runs nix-build here).
result
result-*

# Editor noise.
*.swp
*.swo

# Claude Code. `.claude/mcp.json.sops` is the tracked source; sops-nix
# decrypts it to `.mcp.json` at activation (platform/claude.nix), so the
# plaintext must never be committed. settings.local.json is whatever the
# harness accumulates per-machine; the durable allowlist is in
# .claude/settings.json, which IS tracked.
.mcp.json
.claude/settings.local.json

# stacks/daedalus/app is the one place this repo holds application source
# (source.mode = "local"). Its build/runtime artefacts must stay untracked —
# the flake copies only tracked files into /nix/store, so an untracked
# node_modules costs a rebuild nothing.
stacks/daedalus/app/node_modules/
stacks/daedalus/app/.pnpm-store/
stacks/daedalus/app/.corepack/
stacks/daedalus/app/.vite/
stacks/daedalus/app/.tanstack/
stacks/daedalus/app/.output/
stacks/daedalus/app/dist/
# Generated by the TanStack Router plugin from src/routes — derived, not
# source. `pnpm typecheck` regenerates it before type-checking.
stacks/daedalus/app/src/routeTree.gen.ts

# website/ is a standalone nested pnpm project (the public landing page,
# deployed to GitHub Pages by .github/workflows/website.yml). Its lockfile
# IS tracked (CI installs with --frozen-lockfile); its dependencies, build
# output and generated route tree are not — routeTree.gen.ts is derived from
# src/routes and `pnpm typecheck` regenerates it before type-checking.
website/node_modules/
website/dist/
website/.vite/
website/.tanstack/
website/.output/
website/src/routeTree.gen.ts
website/tsconfig.tsbuildinfo

# pnpm content-addressable store — pnpm falls back to a repo-local store
# because /etc/nixos and /home sit on different ZFS datasets (hardlinks).
.pnpm-store/
