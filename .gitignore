# Backup files we may create during refactors.
*.bak
*.bak.*

# Nix build artifacts (in case anyone runs nix-build here).
result
result-*

# Editor noise.
*.swp
*.swo

# Claude Code's per-machine accumulation; the durable config is tracked.
.claude/settings.local.json

# app/ — the daedalus app. On the box that runs it this directory is
# bind-mounted into the container (source.mode = "local"), so its build and
# runtime artefacts live here and must never be committed.
app/node_modules/
app/.pnpm-store/
app/.corepack/
app/.vite/
app/.tanstack/
app/.output/
app/dist/
# Generated by the TanStack Router plugin from src/routes — derived, not
# source. `pnpm typecheck` regenerates it before type-checking.
app/src/routeTree.gen.ts

# website/ — the public landing page, a standalone pnpm project deployed to
# GitHub Pages by .github/workflows/website.yml. Its lockfile IS tracked (CI
# installs with --frozen-lockfile); dependencies and build output are not.
website/node_modules/
website/dist/
website/.vite/
website/.tanstack/
website/.output/
website/src/routeTree.gen.ts
website/tsconfig.tsbuildinfo

# pnpm content-addressable store, when pnpm falls back to a repo-local one.
.pnpm-store/
